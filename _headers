# Netlify custom headers. Keep the blank post templates and repo notes
# out of search and AI indexes (they are publicly served today).
/_template
  X-Robots-Tag: noindex, nofollow
/_template.html
  X-Robots-Tag: noindex, nofollow
/blog/_template
  X-Robots-Tag: noindex, nofollow
/blog/_template.html
  X-Robots-Tag: noindex, nofollow
/README.md
  X-Robots-Tag: noindex
/blog/README.md
  X-Robots-Tag: noindex
/posts.json
  X-Robots-Tag: noindex
/blog/posts.json
  X-Robots-Tag: noindex


# Private guided demo, shared by link only. Kept out of search and AI indexes.
/tour-722a227774/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Referrer-Policy: no-referrer

/llms.txt
  Content-Type: text/plain; charset=utf-8

/681f6334dcc9af76f40cf15c58ce26d2.txt
  Content-Type: text/plain; charset=utf-8

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/blog/images/*
  Cache-Control: public, max-age=2592000

/assets/brand/*
  Cache-Control: public, max-age=2592000
